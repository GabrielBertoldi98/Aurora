{
  "name": "@cloud-hub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @cloud-hub/contracts build && node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "prebuild": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "pretypecheck": "pnpm --filter @cloud-hub/contracts build && node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "start": "node --env-file=../../.env dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @cloud-hub/contracts build",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloud-hub/contracts": "workspace:*",
    "@better-auth/prisma-adapter": "1.7.20",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.20",
    "express": "5.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.4.2",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
