# URLs e ambiente
NODE_ENV=development
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api
API_INTERNAL_URL=http://localhost:3001
API_PORT=3001

# Serviços locais da Fase 1
POSTGRES_DB=cloud_hub
POSTGRES_USER=cloud_hub
POSTGRES_PASSWORD=cloud_hub_dev_password
DATABASE_URL=postgresql://cloud_hub:cloud_hub_dev_password@localhost:5432/cloud_hub?schema=public
REDIS_URL=redis://localhost:6379

# Reservado para a Fase 2 — nunca versione um valor real.
BETTER_AUTH_SECRET=replace_with_a_high_entropy_secret_of_at_least_32_characters

# Reservado para as fases de provedores — não preencher ainda.
TOKEN_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key
GOOGLE_CLIENT_ID=example-google-client-id
GOOGLE_CLIENT_SECRET=example-google-client-secret
DROPBOX_CLIENT_ID=example-dropbox-client-id
DROPBOX_CLIENT_SECRET=example-dropbox-client-secret
MICROSOFT_CLIENT_ID=example-microsoft-client-id
MICROSOFT_CLIENT_SECRET=example-microsoft-client-secret
